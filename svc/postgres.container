[Unit]
Description=PostgreSQL 17 gestion_norte
After=network-online.target

[Container]
ContainerName=postgres
Image=localhost/postgres-pgaudit:17
Exec=postgres -c shared_preload_libraries=pgaudit
Secret=pg_pass,type=env,target=POSTGRES_PASSWORD
Environment=POSTGRES_USER=admin
Environment=POSTGRES_DB=gestion_norte
Volume=pgdata:/var/lib/postgresql/data
PublishPort=127.0.0.1:5432:5432

[Service]
Restart=always

[Install]
WantedBy=default.target
