[Unit]
Description=Caddy, proxy TLS para Zabbix
Requires=zabbix-web.service
After=zabbix-web.service

[Container]
Image=docker.io/library/caddy:2
ContainerName=caddy
Network=zabbix.network
PublishPort=443:443
Volume=/home/liveuser1/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=caddy-data:/data

[Service]
Restart=always

[Install]
WantedBy=default.target
