, "seed": 129827362, "version": 1, "versionNonce": 100068740, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "túneles WireGuard\nhacia ubu-fw\n(51820/udp)", "fontSize": 12, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "túneles WireGuard\nhacia ubu-fw\n(51820/udp)", "autoResize": true, "lineHeight": 1.25}, {"id": "e143", "type": "text", "x": 40, "y": 1220, "width": 2200, "height": 48.75, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 378502112, "version": 1, "versionNonce": 605508529, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Leyenda: flecha negra = enlace físico/troncal · discontinua morada = túnel cifrado sobre Internet · caja verde = VLAN de la sede · caja naranja = VLAN de dispositivos\nLaboratorio: el switch y los routers de operador no existen; cada VLAN es un VMnet de VMware y ubu-fw tiene una NIC por VMnet. Teruel y las VLAN 50-99 solo en diseño. Windows 7: equipos repartidos entre sedes, aislados hasta su retirada (D19).\nReparto por departamento estimado: Laboral 44/10/6 · Fiscal 33/7/5 · Administración 18/4/3 · Atención 15/4/1 (Zaragoza/Huesca/Teruel). Total 150.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Leyenda: flecha negra = enlace físico/troncal · discontinua morada = túnel cifrado sobre Internet · caja verde = VLAN de la sede · caja naranja = VLAN de dispositivos\nLaboratorio: el switch y los routers de operador no existen; cada VLAN es un VMnet de VMware y ubu-fw tiene una NIC por VMnet. Teruel y las VLAN 50-99 solo en diseño. Windows 7: equipos repartidos entre sedes, aislados hasta su retirada (D19).\nReparto por departamento estimado: Laboral 44/10/6 · Fiscal 33/7/5 · Administración 18/4/3 · Atención 15/4/1 (Zaragoza/Huesca/Teruel). Total 150.", "autoResize": true, "lineHeight": 1.25}], "appState": {"gridSize": null, "viewBackgroundColor": "#ffffff"}, "files": {"fdc892e0a49073bfde23c2864d254b422c734556": {"mimeType": "image/png", "id": "fdc892e0a49073bfde23c2864d254b422c734556", "dataURL": "data:image/png;base64,", "created": 1761580000000, "lastRetrieved": 1761580000000}, "e04c99c1627de37c94f0dea5527e4757a92ffaa3": {"mimeType": "image/png", "id": "e04c99c1627de37c94f0dea5527e4757a92ffaa3", "dataURL": "data:image/png;base64,", "created": 1761580000000, "lastRetrieved": 1761580000000}, "322d50eb805e88f16e5e0b54bee25128f25cfafc": {"mimeType": "image/png", "id": "322d50eb805e88f16e5e0b54bee25128f25cfafc", "dataURL": "data:image/png;base64,", "created": 1761580000000, "lastRetrieved": 1761580000000}, "d9295b0d9e437f3767c49e8d7a45c73ab8c49965": {"mimeType": "image/png", "id": "d9295b0d9e437f3767c49e8d7a45c73ab8c49965", "dataURL": "data:image/png;base64,", "created": 1761580000000, "lastRetrieved": 1761580000000}, "46ece17d76d94ca7653f6dcafa0b7860fbe29c16": {"mimeType": "image/png", "id": "46ece17d76d94ca7653f6dcafa0b7860fbe29c16", "dataURL": "data:image/png;base64,", "created": 1761580000000, "lastRetrieved": 1761580000000}}}