# Firewall de ubu-fw en la maqueta. Es la política del ubu-fw real (red/nftables.conf)
# escrita con conjuntos de redes, para que una regla valga para las tres sedes.
# Para la cuarta sede solo se añaden sus redes a los conjuntos (10.4.x.0/24).
flush ruleset

table inet filtro {

    set dcs {
        type ipv4_addr
        elements = { 10.1.20.10, 10.1.20.11 }
    }
    set laboral {
        type ipv4_addr; flags interval
        elements = { 10.1.30.0/24, 10.2.30.0/24, 10.3.30.0/24 }
    }
    set fiscal {
        type ipv4_addr; flags interval
        elements = { 10.1.40.0/24, 10.2.40.0/24, 10.3.40.0/24 }
    }
    set gestion {
        type ipv4_addr; flags interval
        elements = { 10.1.10.0/24 }
    }
    set equipos_red {
        type ipv4_addr; flags interval
        elements = { 10.2.10.0/24, 10.3.10.0/24 }      # switches de Huesca y Teruel
    }

    chain input {
        type filter hook input priority filter; policy drop;
        ct state invalid drop
        ct state established,related accept
        iif "lo" accept
        iifname { "wan", "wan4g" } udp dport 51820-51823 accept          # WireGuard de las sedes
        iifname "wg*" meta l4proto 89 accept                              # OSPF solo dentro de los túneles
        iifname { "v10", "v20", "v30", "v40" } icmp type echo-request limit rate 10/second accept
        iifname "v10" tcp dport 22 accept
        counter comment "descartado por la política por defecto"
        limit rate 6/minute burst 10 packets log prefix "fw-entrada-denegado: "
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state invalid drop
        ct state established,related accept

        # Departamentos de cualquier sede -> web de Internet
        ip saddr @laboral oifname { "wan", "wan4g" } tcp dport { 80, 443 } accept
        ip saddr @fiscal  oifname { "wan", "wan4g" } tcp dport { 80, 443 } accept

        # Departamentos de cualquier sede -> controladores de dominio (AD, DNS, ficheros)
        ip saddr @laboral ip daddr @dcs tcp dport { 53, 88, 135, 389, 445, 464, 636, 3268, 3269, 49152-65535 } accept
        ip saddr @laboral ip daddr @dcs udp dport { 53, 88, 123, 389, 464 } accept
        ip saddr @fiscal  ip daddr @dcs tcp dport { 53, 88, 135, 389, 445, 464, 636, 3268, 3269, 49152-65535 } accept
        ip saddr @fiscal  ip daddr @dcs udp dport { 53, 88, 123, 389, 464 } accept

        # Gestión de IT -> servidores y equipos de red de las tres sedes
        ip saddr @gestion ip daddr 10.1.20.0/24 tcp dport { 22, 3389, 5986 } accept
        ip saddr @gestion ip daddr @equipos_red tcp dport 22 accept
        ip saddr @gestion icmp type echo-request accept

        # Servidores -> web de Internet (actualizaciones)
        ip saddr 10.1.20.0/24 oifname { "wan", "wan4g" } tcp dport { 80, 443 } accept

        counter comment "descartado por la política por defecto"
        limit rate 6/minute burst 10 packets log prefix "fw-reenvio-denegado: "
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}

table ip nat {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname { "wan", "wan4g" } masquerade
    }
}
