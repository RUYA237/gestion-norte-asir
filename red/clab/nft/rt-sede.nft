# Firewall del router de sede (rt-hue y rt-ter). El router no decide qué se permite
# entre departamentos: manda todo al túnel y ubu-fw aplica la política. Solo
# garantiza tres cosas: que las VLAN de la sede no se hablen entre sí sin pasar por
# ubu-fw, que los invitados solo salgan a Internet y que nada entre desde Internet.
flush ruleset

table inet filtro {

    chain input {
        type filter hook input priority filter; policy drop;
        ct state invalid drop
        ct state established,related accept
        iif "lo" accept
        iifname "wg*" meta l4proto 89 accept                       # OSPF solo dentro de los túneles
        iifname "wg*" ip saddr 10.1.10.0/24 tcp dport 22 accept     # administración desde Zaragoza
        iifname { "v10", "v30", "v40", "v80" } icmp type echo-request limit rate 10/second accept
        counter comment "descartado por la política por defecto"
        limit rate 6/minute burst 10 packets log prefix "sede-entrada-denegado: "
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state invalid drop
        ct state established,related accept
        iifname { "v10", "v30", "v40" } oifname "wg*" accept      # empresa -> túnel (decide ubu-fw)
        iifname "wg*" oifname { "v10", "v30", "v40" } accept      # lo que ubu-fw ya ha permitido
        iifname "v80" ip daddr 10.0.0.0/8 counter drop comment "invitados hacia la empresa"
        iifname "v80" oifname "wan" accept                         # invitados -> solo Internet
        counter comment "descartado por la política por defecto"
        limit rate 6/minute burst 10 packets log prefix "sede-reenvio-denegado: "
    }
}

table ip nat {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "wan" masquerade
    }
}
