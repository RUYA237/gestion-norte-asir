network:
  version: 2
  renderer: networkd
  ethernets:
    wan:
      match: { macaddress: MAC_WAN }
      set-name: wan
      dhcp4: true
      dhcp6: false
    v10:
      match: { macaddress: MAC_V10 }
      set-name: v10
      addresses: [10.1.10.1/24]
    v20:
      match: { macaddress: MAC_V20 }
      set-name: v20
      addresses: [10.1.20.1/24]
    v30:
      match: { macaddress: MAC_V30 }
      set-name: v30
      addresses: [10.1.30.1/24]
    v40:
      match: { macaddress: MAC_V40 }
      set-name: v40
      addresses: [10.1.40.1/24]
